#!/bin/bash
# newgit_project

set -euo pipefail

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
  echo "Usage: $(basename "$0") new_project_directory" >&2
  exit 1
fi

# Plain mkdir (not -p) so an existing directory stops the script.
mkdir "$1"
cd "$1"
git init
git commit -am "[initial] Empty Commit" --allow-empty
git tag initial -m "Tag initial commit"
